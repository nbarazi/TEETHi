{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-e2e",
      "runtimeExecutable": "C:/Users/ASUS/.config/herd-lite/bin/php.exe",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8000"
      ],
      "cwd": "TEETHi-Backend",
      "env": {
        "MAIL_MAILER": "log",
        "SMS_PROVIDER": "log"
      },
      "port": 8000
    },
    {
      "name": "queue-worker-e2e",
      "runtimeExecutable": "C:/Users/ASUS/.config/herd-lite/bin/php.exe",
      "runtimeArgs": [
        "artisan",
        "queue:work",
        "--tries=3",
        "--backoff=10"
      ],
      "cwd": "TEETHi-Backend",
      "env": {
        "MAIL_MAILER": "log",
        "SMS_PROVIDER": "log"
      },
      "port": 0
    },
